{
    "SeeDocsAt": "https://cosys-lab.github.io/Cosys-AirSim/settings/",
    "SettingsVersion": 2.0,
    "SimMode": "Multirotor",
    "ClockType": "SteppableClock",
    "Vehicles": {
        "PX4": {
            "VehicleType": "PX4Multirotor",
            "UseSerial": false,
            "LockStep": true,
            "UseTcp": true,
            "TcpPort": 4560,
            "ControlPortLocal": 14540,
            "ControlPortRemote": 14580,
            "Sensors": {
                "Barometer": {
                    "SensorType": 1,
                    "Enabled": true,
                    "PressureFactorSigma": 0.0001825
                },
                "Imu":          { "SensorType": 2, "Enabled": true },
                "Gps":          { "SensorType": 3, "Enabled": true },
                "Magnetometer": { "SensorType": 4, "Enabled": true },
                "lidar": {
                    "SensorType": 6,
                    "Enabled": true,
                    "NumberOfChannels": 16,
                    "Range": 40,
                    "MeasurementsPerCycle": 360,
                    "RotationsPerSecond": 10,
                    "UpdateFrequency": 10,
                    "HorizontalFOVStart": 0,
                    "HorizontalFOVEnd": 359,
                    "VerticalFOVUpper": 52,
                    "VerticalFOVLower": -7,
                    "X": 0.0, "Y": 0.0, "Z": -0.15,
                    "Roll": 0, "Pitch": 0, "Yaw": 0,
                    "GenerateNoise": true,
                    "MinNoiseStandardDeviation": 0.01,
                    "NoiseDistanceScale": 1.5,
                    "DrawDebugPoints": false,
                    "External": false
                }
            },
            "Parameters": {
                "NAV_RCL_ACT": 0,
                "NAV_DLL_ACT": 0,
                "COM_RCL_EXCEPT": 4
            },
            "Cameras": {
                "front_cam": {
                    "CaptureSettings": [
                        { "ImageType": 0, "Width": 640, "Height": 360, "FOV_Degrees": 90 }
                    ],
                    "X": 0.30, "Y": 0.0, "Z": -0.10,
                    "Pitch": 0.0, "Roll": 0.0, "Yaw": 0.0
                }
            }
        }
    }
}
